@model IEnumerable<FloodLink.Models.Announcement>

@{
    ViewData["Title"] = "Emergency Announcements";
    string category = ViewBag.Category as string ?? "";
    string urgency = ViewBag.Urgency as string ?? "";
    string search = ViewBag.Search as string ?? "";
    int currentPage = (int)(ViewBag.CurrentPage ?? 1);
    int totalPages = (int)(ViewBag.TotalPages ?? 1);
    int totalCount = (int)(ViewBag.TotalCount ?? 0);
    var categories = ViewBag.Categories as string[] ?? Array.Empty<string>();
    var urgencies = ViewBag.Urgencies as string[] ?? Array.Empty<string>();
    bool canManage = User.IsInRole("Super Admin") || User.IsInRole("Admin") || User.IsInRole("Coordinator") || User.IsInRole("Organization Admin") || User.IsInRole("Organization");

    string UrgencyBadge(string u) => u switch
    {
        "Critical" => "bg-danger text-white",
        "High" => "bg-warning text-dark",
        "Normal" => "bg-primary text-white",
        "Low" => "bg-secondary text-white",
        _ => "bg-info text-dark"
    };

    string CardBorder(string u) => u switch
    {
        "Critical" => "border-danger border-2",
        "High" => "border-warning border-2",
        _ => "border-0"
    };

    string CategoryIcon(string c) => c switch
    {
        "Flood Warning" => "bi-water text-danger",
        "Shelter Opening" => "bi-door-open-fill text-success",
        "Shelter Closing" => "bi-door-closed-fill text-secondary",
        "Volunteer Recruitment" => "bi-people-fill text-primary",
        "Relief Distribution Schedule" => "bi-calendar-check-fill text-info",
        "Safety Instructions" => "bi-shield-check text-warning",
        _ => "bi-megaphone-fill text-primary"
    };
}

<div class="container mt-4 mb-5">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
        <div>
            <h2 class="fw-bold mb-1">📢 Emergency Announcements</h2>
            <p class="text-muted mb-0">Official flood warnings, shelter notices, volunteer calls, and relief distribution schedules</p>
        </div>
        @if (canManage)
        {
            <a asp-action="Create" class="btn btn-danger shadow-sm">
                <i class="bi bi-broadcast me-1"></i> Publish Announcement
            </a>
        }
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Search & Filter Card -->
    <div class="card shadow-sm border-0 mb-4 bg-light">
        <div class="card-body p-3">
            <form method="get" asp-action="Index" class="row g-2 align-items-center">
                <div class="col-md-5">
                    <input type="text" name="search" value="@search" class="form-control" placeholder="Search notices, areas, keywords..." />
                </div>
                <div class="col-md-3">
                    <select name="category" class="form-select">
                        <option value="">All Categories</option>
                        @foreach (var c in categories)
                        {
                            <option value="@c" selected="@(category == c)">@c</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <select name="urgency" class="form-select">
                        <option value="">All Priorities</option>
                        @foreach (var u in urgencies)
                        {
                            <option value="@u" selected="@(urgency == u)">@u</option>
                        }
                    </select>
                </div>
                <div class="col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-secondary w-100"><i class="bi bi-filter"></i> Filter</button>
                    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-x"></i></a>
                </div>
            </form>
        </div>
    </div>

    <!-- Announcements Stream -->
    <div class="row g-3">
        @if (!Model.Any())
        {
            <div class="col-12">
                <div class="card shadow-sm border-0 p-5 text-center text-muted">
                    <i class="bi bi-megaphone fs-1 d-block mb-3"></i>
                    <h5>No announcements published yet.</h5>
                    <p class="small">Important disaster notices and warnings will appear here.</p>
                </div>
            </div>
        }
        else
        {
            @foreach (var a in Model)
            {
                <div class="col-12">
                    <div class="card shadow-sm @CardBorder(a.UrgencyLevel) h-100">
                        <div class="card-body p-4">
                            <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-2">
                                <div class="d-flex align-items-center gap-2">
                                    <i class="bi @CategoryIcon(a.Category) fs-4"></i>
                                    <div>
                                        <h5 class="fw-bold mb-0">
                                            <a asp-action="Details" asp-route-id="@a.Id" class="text-dark text-decoration-none">
                                                @a.Title
                                            </a>
                                        </h5>
                                        <span class="badge bg-light text-dark border me-1">@a.Category</span>
                                        <span class="badge @UrgencyBadge(a.UrgencyLevel) me-1">@a.UrgencyLevel Urgency</span>
                                        @if (!a.IsActive)
                                        {
                                            <span class="badge bg-secondary">Inactive / Expired</span>
                                        }
                                    </div>
                                </div>
                                <div class="text-end text-muted small">
                                    <i class="bi bi-clock me-1"></i> @a.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy HH:mm")
                                    @if (!string.IsNullOrEmpty(a.TargetArea))
                                    {
                                        <div class="fw-semibold text-danger"><i class="bi bi-geo-alt"></i> @a.TargetArea</div>
                                    }
                                </div>
                            </div>

                            <p class="card-text text-secondary mb-3 mt-2" style="white-space: pre-line;">
                                @(a.Content.Length > 280 ? a.Content.Substring(0, 280) + "..." : a.Content)
                            </p>

                            <div class="d-flex justify-content-between align-items-center border-top pt-3 mt-2">
                                <small class="text-muted">
                                    <i class="bi bi-building me-1"></i> Issued by: <strong>@(a.Organization?.OrganizationName ?? "FloodLink Central Coordination")</strong>
                                </small>
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Details" asp-route-id="@a.Id" class="btn btn-outline-primary">
                                        Read Full Notice &rarr;
                                    </a>
                                    @if (canManage)
                                    {
                                        <a asp-action="Edit" asp-route-id="@a.Id" class="btn btn-outline-secondary">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <form asp-action="ToggleActive" asp-route-id="@a.Id" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-secondary" title="@(a.IsActive ? "Deactivate" : "Activate")">
                                                <i class="bi @(a.IsActive ? "bi-eye-slash" : "bi-eye")"></i>
                                            </button>
                                        </form>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    </div>

    @if (totalPages > 1)
    {
        <div class="d-flex justify-content-between align-items-center mt-4">
            <small class="text-muted">Page @currentPage of @totalPages (@totalCount notices)</small>
            <nav>
                <ul class="pagination pagination-sm mb-0">
                    @for (int p = 1; p <= totalPages; p++)
                    {
                        <li class="page-item @(p == currentPage ? "active" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@p" asp-route-category="@category" asp-route-urgency="@urgency" asp-route-search="@search">@p</a>
                        </li>
                    }
                </ul>
            </nav>
        </div>
    }
</div>
