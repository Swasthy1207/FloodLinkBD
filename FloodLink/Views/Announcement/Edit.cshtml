@model FloodLink.Models.Announcement

@{
    ViewData["Title"] = "Edit Announcement";
    var categories = ViewBag.Categories as string[] ?? Array.Empty<string>();
    var urgencies = ViewBag.Urgencies as string[] ?? Array.Empty<string>();
    var orgs = ViewBag.Organizations as List<FloodLink.Models.Organization> ?? new List<FloodLink.Models.Organization>();
}

<div class="container mt-4 mb-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-secondary text-white py-3">
                    <h5 class="mb-0"><i class="bi bi-pencil-square me-2"></i> Edit Emergency Announcement</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Edit" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <div class="mb-3">
                            <label asp-for="Title" class="form-label fw-bold"></label>
                            <input asp-for="Title" class="form-control" />
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="Category" class="form-label fw-bold"></label>
                                <select asp-for="Category" class="form-select">
                                    @foreach (var c in categories)
                                    {
                                        <option value="@c">@c</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="UrgencyLevel" class="form-label fw-bold"></label>
                                <select asp-for="UrgencyLevel" class="form-select">
                                    <option value="Critical">🚨 Critical</option>
                                    <option value="High">⚠️ High Priority</option>
                                    <option value="Normal">📢 Normal</option>
                                    <option value="Low">ℹ️ Low / Informational</option>
                                </select>
                            </div>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="TargetArea" class="form-label fw-bold"></label>
                                <input asp-for="TargetArea" class="form-control" />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="OrganizationId" class="form-label fw-bold">Organization</label>
                                <select asp-for="OrganizationId" class="form-select">
                                    <option value="">-- FloodLink Central / Coordination --</option>
                                    @foreach (var o in orgs)
                                    {
                                        <option value="@o.Id">@o.OrganizationName</option>
                                    }
                                </select>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Content" class="form-label fw-bold"></label>
                            <textarea asp-for="Content" rows="6" class="form-control"></textarea>
                            <span asp-validation-for="Content" class="text-danger small"></span>
                        </div>

                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label asp-for="ExpiresAt" class="form-label fw-bold"></label>
                                <input asp-for="ExpiresAt" type="datetime-local" class="form-control" />
                            </div>
                            <div class="col-md-6 d-flex align-items-center">
                                <div class="form-check mt-3">
                                    <input asp-for="IsActive" class="form-check-input" />
                                    <label asp-for="IsActive" class="form-check-label fw-semibold">Active & Visible</label>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center">
                            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancel</a>
                            <button type="submit" class="btn btn-primary px-4"><i class="bi bi-check2 me-1"></i> Update Announcement</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
