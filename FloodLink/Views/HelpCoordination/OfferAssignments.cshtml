@model IEnumerable<FloodLink.Models.OrganizationHelpOfferAssignment>

@{
    ViewData["Title"] = "Volunteer Assignments";

    var offer =
        ViewBag.Offer as FloodLink.Models.OrganizationHelpOffer;
}

<div class="container py-4">

    <div class="mb-4">

        <a asp-action="AcceptedOffers"
           class="btn btn-outline-secondary mb-3">

            <i class="bi bi-arrow-left me-1"></i>
            Back to Accepted Offers

        </a>

        <h2 class="fw-bold">
            <i class="bi bi-people me-2"></i>
            Volunteer Assignments
        </h2>

    </div>

    @if (offer != null)
    {
        <div class="card shadow-sm mb-4">

            <div class="card-body">

                <h5 class="fw-bold">
                    @offer.HelpNeed?.Title
                </h5>

                <p class="mb-1">
                    <strong>Requesting Organization:</strong>
                    @offer.HelpNeed?.Organization?.OrganizationName
                </p>

                <p class="mb-0">
                    <strong>Help:</strong>
                    @offer.OfferedHelpType
                </p>

            </div>

        </div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No volunteers have been assigned yet.
        </div>
    }
    else
    {
        <div class="table-responsive">

            <table class="table table-hover align-middle">

                <thead class="table-light">

                    <tr>
                        <th>Volunteer</th>
                        <th>Status</th>
                        <th>Assigned At</th>
                        <th>Notes</th>
                    </tr>

                </thead>

                <tbody>

                    @foreach (var assignment in Model)
                    {
                        <tr>

                            <td>
                                <strong>
                                    @(assignment.VolunteerProfile?.User?.FullName
                                        ?? "Unknown")
                                </strong>

                                <br />

                                <small class="text-muted">
                                    @(assignment.VolunteerProfile?.User?.Email
                                        ?? "")
                                </small>
                            </td>

                            <td>

                                @if (assignment.Status == "Assigned")
                                {
                                    <span class="badge bg-primary">
                                        Assigned
                                    </span>
                                }
                                else if (assignment.Status == "In Progress")
                                {
                                    <span class="badge bg-warning text-dark">
                                        In Progress
                                    </span>
                                }
                                else if (assignment.Status == "Completed")
                                {
                                    <span class="badge bg-success">
                                        Completed
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        @assignment.Status
                                    </span>
                                }

                            </td>

                            <td>
                                @assignment.AssignedAt.ToLocalTime()
                                .ToString("dd MMM yyyy HH:mm")
                            </td>

                            <td>
                                @(string.IsNullOrWhiteSpace(assignment.Notes)
                                    ? "-"
                                    : assignment.Notes)
                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }

</div>