@model FloodLink.Models.Organization

@{
    ViewData["Title"] = "Delete Organization";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">

            <div class="card border-0 shadow-sm border-top border-danger" style="border-top-width: 3px!important;">
                <div class="card-body p-4">

                    <h2 class="text-danger mb-2">Delete Organization</h2>
                    <p class="text-muted mb-4">
                        You are about to permanently delete this organization. This action cannot be undone.
                    </p>

                    <dl class="row mb-4">
                        <dt class="col-sm-4 text-muted">Organization</dt>
                        <dd class="col-sm-8 fw-semibold">@Model.OrganizationName</dd>

                        <dt class="col-sm-4 text-muted">Type</dt>
                        <dd class="col-sm-8">@Model.OrganizationType</dd>

                        <dt class="col-sm-4 text-muted">Contact</dt>
                        <dd class="col-sm-8">@Model.ContactEmail</dd>

                        <dt class="col-sm-4 text-muted">Status</dt>
                        <dd class="col-sm-8">
                            <span class="badge bg-warning text-dark">@Model.Status</span>
                        </dd>

                        <dt class="col-sm-4 text-muted">Registered</dt>
                        <dd class="col-sm-8">@Model.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</dd>
                    </dl>

                    <div class="alert alert-warning border-0 py-2 small">
                        <strong>Note:</strong> Only Pending or Rejected organizations can be deleted.
                    </div>

                    <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-flex gap-2 mt-3">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-danger px-4">
                            Yes, Delete Permanently
                        </button>
                        <a asp-action="Details" asp-route-id="@Model.Id"
                           class="btn btn-outline-secondary">Cancel</a>
                    </form>

                </div>
            </div>

        </div>
    </div>
</div>
