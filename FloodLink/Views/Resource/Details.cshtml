@model FloodLink.Models.Resource

@{
    ViewData["Title"] = Model.ResourceName;
    bool canManage = User.IsInRole("Super Admin") || User.IsInRole("Admin") || User.IsInRole("Coordinator") || User.IsInRole("Organization Admin") || User.IsInRole("Organization");

    string StatusBadge(string s) => s switch
    {
        "Available" => "bg-success",
        "In Use / Deployed" => "bg-primary",
        "Low Stock" => "bg-warning text-dark",
        "Depleted" => "bg-danger",
        "Under Maintenance" => "bg-secondary",
        _ => "bg-light text-dark border"
    };
}

<div class="container mt-4 mb-5">
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index">Inventory</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.ResourceName</li>
        </ol>
    </nav>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row g-4">
        <!-- Item Overview -->
        <div class="col-lg-7">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                    <div>
                        <h4 class="mb-1">@Model.ResourceName</h4>
                        <span class="badge @(Model.ItemClassification == "Equipment" ? "bg-primary" : "bg-info text-dark") me-1">@Model.ItemClassification</span>
                        <span class="badge bg-light text-dark border me-1">@Model.Category</span>
                        <span class="badge @StatusBadge(Model.Status)">@Model.Status</span>
                    </div>
                    <div class="btn-group">
                        @if (Model.Status != "Depleted")
                        {
                            <a asp-action="Distribute" asp-route-id="@Model.Id" class="btn btn-sm btn-primary">
                                <i class="bi bi-send me-1"></i> Distribute / Deploy
                            </a>
                        }
                        @if (canManage)
                        {
                            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-secondary">
                                <i class="bi bi-pencil"></i>
                            </a>
                        }
                    </div>
                </div>
                <div class="card-body">
                    <div class="p-3 bg-light rounded mb-4 text-center">
                        <small class="text-muted text-uppercase fw-semibold d-block">Current Stock / Fleet Size</small>
                        <h1 class="display-5 fw-bold my-1 text-primary">@Model.Quantity</h1>
                        <span class="text-muted fw-semibold">@Model.Unit available</span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-sm-6">
                            <h6 class="text-muted small text-uppercase fw-semibold mb-1">Storage / Station Location</h6>
                            <p class="fw-semibold mb-0"><i class="bi bi-geo-alt text-danger me-1"></i> @(Model.Location ?? "Not specified")</p>
                        </div>
                        <div class="col-sm-6">
                            <h6 class="text-muted small text-uppercase fw-semibold mb-1">Assigned Organization</h6>
                            <p class="fw-semibold mb-0"><i class="bi bi-building text-primary me-1"></i> @(Model.Organization?.OrganizationName ?? "Multi-Organization Pool")</p>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.Notes))
                    {
                        <div class="mt-3">
                            <h6 class="text-muted small text-uppercase fw-semibold mb-1">Notes & Specifications</h6>
                            <p class="text-secondary bg-light p-3 rounded">@Model.Notes</p>
                        </div>
                    }

                    <div class="text-muted small border-top pt-2 mt-4 d-flex justify-content-between">
                        <span>Added: @Model.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy HH:mm")</span>
                        @if (Model.UpdatedAt.HasValue)
                        {
                            <span>Last Updated: @Model.UpdatedAt.Value.ToLocalTime().ToString("MMM dd, yyyy HH:mm")</span>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Distribution History -->
        <div class="col-lg-5">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                    <h5 class="mb-0"><i class="bi bi-journal-text me-1 text-primary"></i> Distribution History</h5>
                    <span class="badge bg-secondary">@(Model.Distributions?.Count ?? 0) logs</span>
                </div>
                <div class="card-body p-0">
                    @if (Model.Distributions == null || !Model.Distributions.Any())
                    {
                        <div class="p-4 text-center text-muted">
                            <i class="bi bi-clock-history fs-2 d-block mb-1"></i>
                            No distribution or deployment records for this item yet.
                        </div>
                    }
                    else
                    {
                        <ul class="list-group list-group-flush">
                            @foreach (var d in Model.Distributions.OrderByDescending(x => x.DistributionDate))
                            {
                                <li class="list-group-item p-3">
                                    <div class="d-flex justify-content-between align-items-start mb-1">
                                        <span class="fw-bold text-dark">
                                            <i class="bi bi-box-arrow-right text-success me-1"></i> @d.Quantity @Model.Unit
                                        </span>
                                        <small class="text-muted">@d.DistributionDate.ToLocalTime().ToString("MMM dd, yyyy")</small>
                                    </div>
                                    <p class="mb-1 small">
                                        <strong>To:</strong> @d.DistributedTo
                                        @if (d.DisasterOperation != null)
                                        {
                                            <span class="badge bg-light text-dark border ms-1">@d.DisasterOperation.OperationName</span>
                                        }
                                    </p>
                                    @if (!string.IsNullOrEmpty(d.Remarks))
                                    {
                                        <p class="mb-0 text-muted small fst-italic">"@d.Remarks"</p>
                                    }
                                </li>
                            }
                        </ul>
                    }
                </div>
                <div class="card-footer bg-white text-center py-2">
                    <a asp-action="Distribute" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-primary w-100">
                        <i class="bi bi-plus"></i> Record New Distribution
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
