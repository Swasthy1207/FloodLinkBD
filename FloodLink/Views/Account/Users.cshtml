@model IEnumerable<FloodLink.Models.UserManagementViewModel>

@{
    ViewData["Title"] = "User & Roles Management";
    string currentSearch = ViewBag.Search ?? "";
    string currentRole = ViewBag.Role ?? "";
    string currentStatus = ViewBag.Status ?? "";
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int totalCount = ViewBag.TotalCount ?? 0;
    var allRoles = ViewBag.AllRoles as List<string> ?? new List<string>();

    string RoleBadge(string role) => role switch
    {
        "Super Admin" or "Admin" => "bg-danger",
        "Organization Admin" or "Organization" => "bg-primary",
        "Coordinator" => "bg-info text-dark",
        "Volunteer" => "bg-success",
        "Community Reporter" => "bg-warning text-dark",
        _ => "bg-secondary"
    };
}

<div class="container py-4 mb-5">

    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
            <li class="breadcrumb-item active" aria-current="page">User & Roles Management</li>
        </ol>
    </nav>

    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
        <div>
            <h2 class="fw-bold mb-0">👥 User & Roles Management</h2>
            <p class="text-muted mb-0">Manage registered system accounts, verification status, and role privileges across FloodLink.</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <span class="badge bg-light text-dark border px-3 py-2 fs-6">
                <strong>@totalCount</strong> Total Registered User@(totalCount == 1 ? "" : "s")
            </span>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Search & Filter Controls -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-3">
            <form method="get" asp-action="Users">
                <div class="row g-2 align-items-end">
                    <div class="col-md-5">
                        <label class="form-label small fw-semibold text-muted mb-1">Search Users</label>
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                            <input type="text" name="search" value="@currentSearch"
                                   class="form-control form-control-sm"
                                   placeholder="Search by name, email, or phone..." />
                        </div>
                    </div>

                    <div class="col-md-3">
                        <label class="form-label small fw-semibold text-muted mb-1">Filter by Role</label>
                        <select name="role" class="form-select form-select-sm">
                            <option value="">All Roles</option>
                            @foreach (var r in allRoles)
                            {
                                <option value="@r" selected="@(currentRole == r ? "selected" : null)">@r</option>
                            }
                        </select>
                    </div>

                    <div class="col-md-2">
                        <label class="form-label small fw-semibold text-muted mb-1">Status</label>
                        <select name="status" class="form-select form-select-sm">
                            <option value="">All Statuses</option>
                            <option value="Active" selected="@(currentStatus == "Active" ? "selected" : null)">Active</option>
                            <option value="Inactive" selected="@(currentStatus == "Inactive" ? "selected" : null)">Inactive</option>
                            <option value="Pending" selected="@(currentStatus == "Pending" ? "selected" : null)">Pending</option>
                        </select>
                    </div>

                    <div class="col-md-2 d-flex gap-2">
                        <button type="submit" class="btn btn-primary btn-sm flex-grow-1">
                            <i class="bi bi-funnel me-1"></i> Filter
                        </button>
                        @if (!string.IsNullOrEmpty(currentSearch) || !string.IsNullOrEmpty(currentRole) || !string.IsNullOrEmpty(currentStatus))
                        {
                            <a asp-action="Users" class="btn btn-outline-secondary btn-sm" title="Clear Filters">
                                <i class="bi bi-x-lg"></i>
                            </a>
                        }
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Users Table -->
    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="min-width: 200px;">User</th>
                        <th>Email & Verification</th>
                        <th>Roles</th>
                        <th>Status</th>
                        <th>Registered Date</th>
                        <th class="text-end" style="min-width: 180px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <div class="fs-1 mb-2"><i class="bi bi-people"></i></div>
                                <h5>No users found</h5>
                                <p class="small mb-0">Try adjusting your search or filter options.</p>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var user in Model)
                        {
                            <tr>
                                <td>
                                    <div class="fw-bold text-dark">@user.FullName</div>
                                    <small class="text-muted">ID: @user.Id.Substring(0, Math.Min(8, user.Id.Length))...</small>
                                    @if (!string.IsNullOrEmpty(user.OrganizationName))
                                    {
                                        <div>
                                            <span class="badge bg-light text-primary border small">
                                                <i class="bi bi-building me-1"></i>@user.OrganizationName
                                            </span>
                                        </div>
                                    }
                                </td>
                                <td>
                                    <div>@user.Email</div>
                                    @if (user.EmailConfirmed)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle small">
                                            <i class="bi bi-check-circle-fill me-1"></i>Verified
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning-subtle text-warning border border-warning-subtle small">
                                            <i class="bi bi-clock-history me-1"></i>Unverified
                                        </span>
                                    }
                                    @if (!string.IsNullOrEmpty(user.PhoneNumber))
                                    {
                                        <div class="small text-muted"><i class="bi bi-telephone me-1"></i>@user.PhoneNumber</div>
                                    }
                                </td>
                                <td>
                                    <div class="d-flex flex-wrap gap-1">
                                        @if (user.Roles.Any())
                                        {
                                            @foreach (var role in user.Roles)
                                            {
                                                <span class="badge @RoleBadge(role)">@role</span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Citizen</span>
                                        }
                                    </div>
                                </td>
                                <td>
                                    @if (user.Status == "Active")
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else if (user.Status == "Inactive")
                                    {
                                        <span class="badge bg-secondary">Inactive</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">@user.Status</span>
                                    }
                                </td>
                                <td>
                                    <span class="small text-muted">@user.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy")</span>
                                </td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="UserDetails" asp-route-id="@user.Id"
                                           class="btn btn-outline-primary" title="View Details">
                                            <i class="bi bi-eye"></i> Details
                                        </a>
                                        
                                        <form asp-action="ToggleUserStatus" asp-route-id="@user.Id" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit"
                                                    class="btn @(user.Status == "Active" ? "btn-outline-warning" : "btn-outline-success") btn-sm"
                                                    title="@(user.Status == "Active" ? "Deactivate" : "Activate") User"
                                                    onclick="return confirm('Change status for @user.FullName to @(user.Status == "Active" ? "Inactive" : "Active")?')">
                                                <i class="bi @(user.Status == "Active" ? "bi-slash-circle" : "bi-check-circle")"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        @if (totalPages > 1)
        {
            <div class="card-footer bg-white border-top py-3">
                <nav aria-label="User navigation">
                    <ul class="pagination pagination-sm justify-content-center mb-0">
                        <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                            <a class="page-link" asp-action="Users"
                               asp-route-page="@(currentPage - 1)"
                               asp-route-search="@currentSearch"
                               asp-route-role="@currentRole"
                               asp-route-status="@currentStatus">&laquo; Prev</a>
                        </li>
                        @for (int p = 1; p <= totalPages; p++)
                        {
                            <li class="page-item @(p == currentPage ? "active" : "")">
                                <a class="page-link" asp-action="Users"
                                   asp-route-page="@p"
                                   asp-route-search="@currentSearch"
                                   asp-route-role="@currentRole"
                                   asp-route-status="@currentStatus">@p</a>
                            </li>
                        }
                        <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                            <a class="page-link" asp-action="Users"
                               asp-route-page="@(currentPage + 1)"
                               asp-route-search="@currentSearch"
                               asp-route-role="@currentRole"
                               asp-route-status="@currentStatus">Next &raquo;</a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>

</div>
