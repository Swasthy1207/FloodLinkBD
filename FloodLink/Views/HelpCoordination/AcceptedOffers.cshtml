@model IEnumerable<FloodLink.Models.OrganizationHelpOffer>

@{
    ViewData["Title"] = "Accepted Help Offers";
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold">
                <i class="bi bi-check-circle me-2"></i>
                Accepted Help Offers
            </h2>

            <p class="text-muted mb-0">
                Assign your organization's volunteers to accepted help offers.
            </p>
        </div>

        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>
            Help Requests
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle me-2"></i>
            Your organization has no accepted help offers yet.
        </div>
    }
    else
    {
        <div class="row g-4">

            @foreach (var offer in Model)
            {
                <div class="col-md-6">

                    <div class="card shadow-sm h-100">

                        <div class="card-body">

                            <div class="d-flex justify-content-between mb-2">

                                <span class="badge bg-success">
                                    Accepted
                                </span>

                                <small class="text-muted">
                                    @offer.RespondedAt?.ToLocalTime().ToString("dd MMM yyyy HH:mm")
                                </small>

                            </div>

                            <h5 class="fw-bold">
                                @offer.HelpNeed?.Title
                            </h5>

                            <p class="text-muted">
                                Requesting Organization:
                                <strong>
                                    @offer.HelpNeed?.Organization?.OrganizationName
                                </strong>
                            </p>

                            <hr />

                            <p class="mb-1">
                                <strong>Help:</strong>
                                @offer.OfferedHelpType
                            </p>

                            @if (!string.IsNullOrWhiteSpace(offer.OfferedQuantity))
                            {
                                <p class="mb-1">
                                    <strong>Quantity:</strong>
                                    @offer.OfferedQuantity
                                </p>
                            }

                            @if (!string.IsNullOrWhiteSpace(offer.Message))
                            {
                                <p class="mb-3">
                                    <strong>Message:</strong>
                                    @offer.Message
                                </p>
                            }

                            <div class="d-flex gap-2 mt-3">

                                <a asp-action="AssignVolunteer"
                                   asp-route-id="@offer.HelpOfferId"
                                   class="btn btn-primary">

                                    <i class="bi bi-person-plus me-1"></i>
                                    Assign Volunteer

                                </a>

                                <a asp-action="OfferAssignments"
                                   asp-route-id="@offer.HelpOfferId"
                                   class="btn btn-outline-secondary">

                                    <i class="bi bi-people me-1"></i>
                                    View Assignments

                                </a>

                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>
    }

</div>