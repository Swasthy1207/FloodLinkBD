@model IEnumerable<FloodLink.Models.ResourceDistribution>

@{
    ViewData["Title"] = "Resource Distribution Log";
    int currentPage = (int)(ViewBag.CurrentPage ?? 1);
    int totalPages = (int)(ViewBag.TotalPages ?? 1);
    int totalCount = (int)(ViewBag.TotalCount ?? 0);
}

<div class="container mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">📋 Relief Distribution Records</h2>
            <p class="text-muted mb-0">Comprehensive audit trail of all relief supplies and equipment deployed</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Back to Inventory
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Date</th>
                        <th>Item Distributed</th>
                        <th>Category</th>
                        <th>Quantity</th>
                        <th>Destination / Beneficiary</th>
                        <th>Relief Operation</th>
                        <th>Distributed By</th>
                        <th>Remarks</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">
                                <i class="bi bi-clock-history fs-1 d-block mb-2"></i>
                                No distribution records recorded yet.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var d in Model)
                        {
                            <tr>
                                <td>
                                    <small class="fw-semibold">@d.DistributionDate.ToLocalTime().ToString("MMM dd, yyyy")</small><br />
                                    <small class="text-muted">@d.DistributionDate.ToLocalTime().ToString("HH:mm")</small>
                                </td>
                                <td>
                                    @if (d.Resource != null)
                                    {
                                        <a asp-action="Details" asp-route-id="@d.Resource.Id" class="fw-bold text-decoration-none">
                                            @d.Resource.ResourceName
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Unknown item</span>
                                    }
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">@(d.Resource?.Category ?? "Supplies")</span>
                                </td>
                                <td>
                                    <span class="fw-bold text-success fs-6">@d.Quantity</span> <small class="text-muted">@(d.Resource?.Unit ?? "units")</small>
                                </td>
                                <td>
                                    <strong>@d.DistributedTo</strong>
                                </td>
                                <td>
                                    @if (d.DisasterOperation != null)
                                    {
                                        <span class="badge bg-primary">@d.DisasterOperation.OperationName</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Standalone</span>
                                    }
                                </td>
                                <td>
                                    <small class="text-muted">@(d.DistributedBy?.FullName ?? d.DistributedBy?.UserName ?? "System Coordinator")</small>
                                </td>
                                <td>
                                    <small class="text-muted">@(d.Remarks ?? "-")</small>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        @if (totalPages > 1)
        {
            <div class="card-footer bg-white d-flex justify-content-between align-items-center py-3">
                <small class="text-muted">Page @currentPage of @totalPages (@totalCount total distribution entries)</small>
                <nav>
                    <ul class="pagination pagination-sm mb-0">
                        @for (int p = 1; p <= totalPages; p++)
                        {
                            <li class="page-item @(p == currentPage ? "active" : "")">
                                <a class="page-link" asp-action="Distributions" asp-route-page="@p">@p</a>
                            </li>
                        }
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>
