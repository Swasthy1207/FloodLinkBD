@model FloodLink.Models.DisasterOperation
@using FloodLink.Models

@{
    ViewData["Title"] = Model.OperationName;
    var partners = ViewBag.Partners as List<OrganizationOperation> ?? new();
    var related  = ViewBag.RelatedRequests as List<HelpRequest> ?? new();
    var approvedOrgs = ViewBag.ApprovedOrgs as List<Organization>;
}

<div class="container py-4">

    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a asp-action="PublicActivities">Activities</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.OperationName</li>
        </ol>
    </nav>

    <div class="row g-4">

        <!-- ── LEFT: Main operation info ── -->
        <div class="col-lg-8">

            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body p-4">

                    <!-- Status bar -->
                    <div class="d-flex align-items-center gap-2 mb-3">
                        @{
                            var sc = Model.Status switch {
                                "Active"    => "bg-warning text-dark",
                                "Completed" => "bg-fl-green text-white",
                                "Cancelled" => "bg-danger",
                                _           => "bg-secondary"
                            };
                        }
                        <span class="badge @sc fs-6 px-3 py-2">@Model.Status</span>
                        @if (!string.IsNullOrEmpty(Model.DisasterType))
                        {
                            <span class="badge bg-light text-muted border">@Model.DisasterType</span>
                        }
                    </div>

                    <h1 class="h3 fw-bold mb-3">@Model.OperationName</h1>

                    @if (!string.IsNullOrEmpty(Model.Description))
                    {
                        <p class="text-muted mb-4">@Model.Description</p>
                    }

                    <!-- Meta grid -->
                    <div class="row g-3">
                        <div class="col-sm-6">
                            <div class="d-flex align-items-center gap-2">
                                <i class="bi bi-building fs-5 text-fl-green"></i>
                                <div>
                                    <div class="small text-muted">Lead Organization</div>
                                    <strong>@Model.LeadOrganization.OrganizationName</strong>
                                </div>
                            </div>
                        </div>
                        @if (!string.IsNullOrEmpty(Model.Location))
                        {
                            <div class="col-sm-6">
                                <div class="d-flex align-items-center gap-2">
                                    <i class="bi bi-geo-alt fs-5 text-fl-green"></i>
                                    <div>
                                        <div class="small text-muted">Location</div>
                                        <strong>@Model.Location</strong>
                                    </div>
                                </div>
                            </div>
                        }
                        <div class="col-sm-6">
                            <div class="d-flex align-items-center gap-2">
                                <i class="bi bi-calendar fs-5 text-fl-green"></i>
                                <div>
                                    <div class="small text-muted">Started</div>
                                    <strong>@Model.StartDate.ToString("dd MMMM yyyy")</strong>
                                </div>
                            </div>
                        </div>
                        @if (Model.EndDate.HasValue)
                        {
                            <div class="col-sm-6">
                                <div class="d-flex align-items-center gap-2">
                                    <i class="bi bi-calendar-check fs-5 text-fl-green"></i>
                                    <div>
                                        <div class="small text-muted">Ended</div>
                                        <strong>@Model.EndDate.Value.ToString("dd MMMM yyyy")</strong>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Partner Organizations -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-transparent border-0 py-3 px-4">
                    <h5 class="fw-semibold mb-0">
                        <i class="bi bi-people me-2 text-fl-green"></i>
                        Participating Organizations
                        <span class="badge bg-light text-muted ms-2">@(partners.Count + 1)</span>
                    </h5>
                </div>
                <div class="card-body px-4 pb-4">
                    <!-- Lead org -->
                    <div class="d-flex align-items-center gap-3 p-3 bg-light rounded mb-2">
                        <div class="rounded-circle bg-fl-green text-white d-flex align-items-center justify-content-center flex-shrink-0"
                             style="width:38px;height:38px;font-weight:700">
                            @Model.LeadOrganization.OrganizationName.First()
                        </div>
                        <div>
                            <strong>@Model.LeadOrganization.OrganizationName</strong>
                            <span class="badge bg-fl-green ms-2 small">Lead</span>
                        </div>
                    </div>

                    <!-- Partners -->
                    @foreach (var link in partners)
                    {
                        <div class="d-flex align-items-center gap-3 p-3 border rounded mb-2">
                            <div class="rounded-circle bg-secondary text-white d-flex align-items-center justify-content-center flex-shrink-0"
                                 style="width:38px;height:38px;font-weight:700">
                                @link.Organization.OrganizationName.First()
                            </div>
                            <div class="flex-grow-1">
                                <strong>@link.Organization.OrganizationName</strong>
                                @if (!string.IsNullOrEmpty(link.AssignedArea))
                                {
                                    <div class="small text-muted"><i class="bi bi-geo-alt me-1"></i>@link.AssignedArea</div>
                                }
                            </div>
                            <span class="badge bg-light text-muted border small">Partner</span>
                        </div>
                    }

                    @if (!partners.Any())
                    {
                        <p class="text-muted small mb-0">No partner organizations yet.</p>
                    }

                    <!-- Add partner form (admin / org admin only) -->
                    @if (User.IsInRole("Super Admin") || User.IsInRole("Admin") || User.IsInRole("Organization Admin"))
                    {
                        <div class="mt-3 pt-3 border-top">
                            <p class="small fw-semibold mb-2">Add Partner Organization</p>
                            <form asp-action="AddPartnerOrg" method="post" class="row g-2 align-items-end">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="operationId" value="@Model.DisasterOperationId" />
                                <div class="col-md-5">
                                    <select name="organizationId" class="form-select form-select-sm" required>
                                        <option value="">— Select organization —</option>
                                        @if (ViewBag.ApprovedOrgs != null)
                                        {
                                            foreach (var o in (List<Organization>)ViewBag.ApprovedOrgs)
                                            {
                                                <option value="@o.Id">@o.OrganizationName</option>
                                            }
                                        }
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <input type="text" name="assignedArea" class="form-control form-control-sm"
                                           placeholder="Assigned area (optional)" maxlength="300" />
                                </div>
                                <div class="col-md-3">
                                    <button type="submit" class="btn btn-fl-green btn-sm w-100">
                                        <i class="bi bi-plus me-1"></i>Add
                                    </button>
                                </div>
                            </form>
                        </div>
                    }
                </div>
            </div>

            <!-- Related Help Requests -->
            @if (related.Any())
            {
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-transparent border-0 py-3 px-4">
                        <h5 class="fw-semibold mb-0">
                            <i class="bi bi-life-preserver me-2 text-fl-green"></i>Related Help Requests
                        </h5>
                    </div>
                    <div class="list-group list-group-flush">
                        @foreach (var req in related)
                        {
                            <a asp-controller="HelpRequest" asp-action="Details" asp-route-id="@req.Id"
                               class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-3">
                                <div>
                                    <strong>@req.Title</strong>
                                    <div class="small text-muted">@req.Location — @req.Category</div>
                                </div>
                                <span class="badge bg-secondary">@req.Status</span>
                            </a>
                        }
                    </div>
                </div>
            }

        </div>

        <!-- ── RIGHT: Admin actions sidebar ── -->
        @if (User.IsInRole("Super Admin") || User.IsInRole("Admin"))
        {
            <div class="col-lg-4">
                <div class="card border-0 shadow-sm sticky-top" style="top:80px">
                    <div class="card-header bg-danger text-white">
                        <h6 class="mb-0"><i class="bi bi-shield-fill me-1"></i>Super Admin Controls</h6>
                    </div>
                    <div class="card-body">
                        <p class="small text-muted mb-3">Update this operation's status.</p>
                        <form asp-action="UpdateOperationStatus" method="post" class="d-flex flex-column gap-2">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.DisasterOperationId" />
                            @foreach (var s in new[] { "Pending", "Active", "Completed", "Cancelled" })
                            {
                                var btnClass = s == Model.Status ? "btn-fl-green" :
                                              (s == "Cancelled" ? "btn-outline-danger" : "btn-outline-secondary");
                                <button type="submit" name="newStatus" value="@s"
                                        class="btn @btnClass btn-sm text-start"
                                        @(s == Model.Status ? "disabled" : "")>
                                    @if (s == Model.Status) { <i class="bi bi-check-circle me-1"></i> }
                                    @s
                                </button>
                            }
                        </form>
                    </div>
                </div>
            </div>
        }

    </div>

    <div class="mt-4">
        <a asp-action="PublicActivities" class="btn btn-outline-secondary btn-sm">
            ← Back to Activities
        </a>
    </div>

</div>
