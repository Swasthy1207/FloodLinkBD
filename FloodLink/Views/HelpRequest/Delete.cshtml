@model FloodLink.Models.HelpRequest

@{
    ViewData["Title"] = "Delete Help Request";
}

<div class="container mt-4 mb-5">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8">

            <nav aria-label="breadcrumb" class="mb-3">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item">
                        <a asp-controller="HelpRequest" asp-action="MyRequests">My Requests</a>
                    </li>
                    <li class="breadcrumb-item active" aria-current="page">Delete</li>
                </ol>
            </nav>

            <div class="card shadow-sm border-danger">
                <div class="card-header bg-danger text-white py-3">
                    <h5 class="mb-0">Delete Help Request</h5>
                </div>
                <div class="card-body p-4">

                    <div class="alert alert-warning">
                        <strong>Warning:</strong> Are you sure you want to delete this request?
                        This action cannot be undone.
                    </div>

                    <h5 class="mb-3">@Model.Title</h5>

                    <dl class="row mb-0">
                        <dt class="col-sm-4">Category</dt>
                        <dd class="col-sm-8">@Model.Category</dd>

                        <dt class="col-sm-4">Location</dt>
                        <dd class="col-sm-8">@Model.Location</dd>

                        <dt class="col-sm-4">Affected People</dt>
                        <dd class="col-sm-8">@Model.NumberOfPeople</dd>

                        <dt class="col-sm-4">Status</dt>
                        <dd class="col-sm-8">@Model.Status</dd>

                        <dt class="col-sm-4">Submitted</dt>
                        <dd class="col-sm-8">@Model.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</dd>
                    </dl>

                </div>
                <div class="card-footer bg-white border-top py-3 d-flex gap-2">
                    <form asp-controller="HelpRequest"
                          asp-action="Delete"
                          method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />
                        <button type="submit" class="btn btn-danger">
                            Yes, Delete Request
                        </button>
                    </form>
                    <a asp-controller="HelpRequest"
                       asp-action="MyRequests"
                       class="btn btn-outline-secondary">
                        Cancel
                    </a>
                </div>
            </div>

        </div>
    </div>
</div>