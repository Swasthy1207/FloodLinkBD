@model IEnumerable<FloodLink.Models.VolunteerProfile>

@{
    ViewData["Title"] = "Assign Volunteer";

    var offer =
        ViewBag.Offer as FloodLink.Models.OrganizationHelpOffer;
}

<div class="container py-4">

    <div class="mb-4">

        <a asp-action="AcceptedOffers"
           class="btn btn-outline-secondary mb-3">

            <i class="bi bi-arrow-left me-1"></i>
            Back to Accepted Offers

        </a>

        <h2 class="fw-bold">
            <i class="bi bi-person-plus me-2"></i>
            Assign Volunteer
        </h2>

        <p class="text-muted">
            Select an available volunteer from your own organization.
        </p>

    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    @if (offer != null)
    {
        <div class="card shadow-sm mb-4">

            <div class="card-body">

                <h5 class="fw-bold">
                    @offer.HelpNeed?.Title
                </h5>

                <p class="mb-1">
                    <strong>Requested by:</strong>
                    @offer.HelpNeed?.Organization?.OrganizationName
                </p>

                <p class="mb-1">
                    <strong>Help you offered:</strong>
                    @offer.OfferedHelpType
                </p>

                @if (!string.IsNullOrWhiteSpace(offer.OfferedQuantity))
                {
                    <p class="mb-0">
                        <strong>Quantity:</strong>
                        @offer.OfferedQuantity
                    </p>
                }

            </div>

        </div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-warning">

            <i class="bi bi-exclamation-triangle me-2"></i>

            No approved and available volunteers are currently available
            in your organization.

        </div>
    }
    else
    {
        <div class="row g-4">

            @foreach (var volunteer in Model)
            {
                <div class="col-md-6 col-lg-4">

                    <div class="card shadow-sm h-100">

                        <div class="card-body">

                            <h5 class="fw-bold">
                                @(volunteer.User?.FullName ?? "Volunteer")
                            </h5>

                            <p class="text-muted mb-2">
                                @(volunteer.User?.Email ?? "")
                            </p>

                            @if (!string.IsNullOrWhiteSpace(volunteer.Skills))
                            {
                                <p class="mb-2">
                                    <strong>Skills:</strong>
                                    @volunteer.Skills
                                </p>
                            }

                            @if (!string.IsNullOrWhiteSpace(volunteer.CurrentLocation))
                            {
                                <p class="mb-2">
                                    <strong>Location:</strong>
                                    @volunteer.CurrentLocation
                                </p>
                            }

                            <span class="badge bg-success mb-3">
                                Available
                            </span>

                            <form asp-action="AssignVolunteer"
                                  method="post">

                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="id"
                                       value="@offer?.HelpOfferId" />

                                <input type="hidden"
                                       name="volunteerProfileId"
                                       value="@volunteer.Id" />

                                <div class="mb-3">

                                    <label class="form-label">
                                        Assignment Notes
                                    </label>

                                    <textarea name="notes"
                                              class="form-control"
                                              rows="2"
                                              placeholder="Optional instructions..."></textarea>

                                </div>

                                <button type="submit"
                                        class="btn btn-primary w-100">

                                    <i class="bi bi-person-check me-1"></i>
                                    Assign This Volunteer

                                </button>

                            </form>

                        </div>

                    </div>

                </div>
            }

        </div>
    }

</div>