@model IEnumerable<FloodLink.Models.Resource>

@{
    ViewData["Title"] = "Resource & Equipment Management";
    string classification = ViewBag.Classification as string ?? "";
    string category = ViewBag.Category as string ?? "";
    string status = ViewBag.Status as string ?? "";
    string search = ViewBag.Search as string ?? "";
    int currentPage = (int)(ViewBag.CurrentPage ?? 1);
    int totalPages = (int)(ViewBag.TotalPages ?? 1);
    int totalCount = (int)(ViewBag.TotalCount ?? 0);
    var categories = ViewBag.Categories as string[] ?? Array.Empty<string>();
    var statuses = ViewBag.Statuses as string[] ?? Array.Empty<string>();
    bool canManage = User.IsInRole("Super Admin") || User.IsInRole("Admin") || User.IsInRole("Coordinator") || User.IsInRole("Organization Admin") || User.IsInRole("Organization");

    string StatusBadge(string s) => s switch
    {
        "Available" => "bg-success",
        "In Use / Deployed" => "bg-primary",
        "Low Stock" => "bg-warning text-dark",
        "Depleted" => "bg-danger",
        "Under Maintenance" => "bg-secondary",
        _ => "bg-light text-dark border"
    };
}

<div class="container mt-4 mb-5">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
        <div>
            <h2 class="fw-bold mb-1">📦 Relief Resources & Equipment</h2>
            <p class="text-muted mb-0"> Supplies (Food, Water, Medicine, Kits) and Equipment (Boats, Ambulances, Life Jackets)</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Distributions" class="btn btn-outline-primary">
                <i class="bi bi-clock-history me-1"></i> Distribution Log
            </a>
            @if (canManage)
            {
                <a asp-action="Create" class="btn btn-primary shadow-sm">
                    <i class="bi bi-plus-circle me-1"></i> Add Resource / Equipment
                </a>
            }
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Classification Filter Tabs -->
    <ul class="nav nav-pills mb-3">
        <li class="nav-item">
            <a class="nav-link @(string.IsNullOrEmpty(classification) ? "active" : "")" 
               asp-action="Index" asp-route-classification="" asp-route-category="@category" asp-route-status="@status" asp-route-search="@search">
                All Inventory
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(classification == "Resource" ? "active" : "")" 
               asp-action="Index" asp-route-classification="Resource" asp-route-category="@category" asp-route-status="@status" asp-route-search="@search">
                🥫 Relief Supplies
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(classification == "Equipment" ? "active" : "")" 
               asp-action="Index" asp-route-classification="Equipment" asp-route-category="@category" asp-route-status="@status" asp-route-search="@search">
                🚤 Rescue Equipment & Vehicles
            </a>
        </li>
    </ul>

    <!-- Filter Card -->
    <div class="card shadow-sm border-0 mb-4 bg-light">
        <div class="card-body p-3">
            <form method="get" asp-action="Index" class="row g-2 align-items-center">
                <input type="hidden" name="classification" value="@classification" />
                <div class="col-md-4">
                    <input type="text" name="search" value="@search" class="form-control" placeholder="Search item, location, notes..." />
                </div>
                <div class="col-md-3">
                    <select name="category" class="form-select">
                        <option value="">All Categories</option>
                        @foreach (var c in categories)
                        {
                            <option value="@c" selected="@(category == c)">@c</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <select name="status" class="form-select">
                        <option value="">All Statuses</option>
                        @foreach (var s in statuses)
                        {
                            <option value="@s" selected="@(status == s)">@s</option>
                        }
                    </select>
                </div>
                <div class="col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-secondary w-100"><i class="bi bi-filter"></i> Filter</button>
                    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-x"></i></a>
                </div>
            </form>
        </div>
    </div>

    <!-- Table of Inventory -->
    <div class="card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Item</th>
                        <th>Classification</th>
                        <th>Category</th>
                        <th>Available Quantity</th>
                        <th>Status</th>
                        <th>Storage Location</th>
                        <th>Organization</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                No resource or equipment records found.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <div class="fw-bold">@item.ResourceName</div>
                                    @if (!string.IsNullOrEmpty(item.Notes))
                                    {
                                        <small class="text-muted text-truncate d-inline-block" style="max-width: 200px;">@item.Notes</small>
                                    }
                                </td>
                                <td>
                                    <span class="badge @(item.ItemClassification == "Equipment" ? "bg-primary" : "bg-info text-dark")">
                                        @item.ItemClassification
                                    </span>
                                </td>
                                <td><span class="badge bg-light text-dark border">@item.Category</span></td>
                                <td>
                                    <span class="fw-bold fs-6">@item.Quantity</span> <small class="text-muted">@item.Unit</small>
                                </td>
                                <td>
                                    <span class="badge @StatusBadge(item.Status)">@item.Status</span>
                                </td>
                                <td>
                                    <small><i class="bi bi-geo-alt text-muted"></i> @(item.Location ?? "Unspecified")</small>
                                </td>
                                <td>
                                    <small class="fw-semibold">@(item.Organization?.OrganizationName ?? "General / Unaffiliated")</small>
                                </td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-secondary" title="View details & distribution history">
                                            Details
                                        </a>
                                        @if (item.Status != "Depleted")
                                        {
                                            <a asp-action="Distribute" asp-route-id="@item.Id" class="btn btn-outline-primary" title="Record distribution">
                                                Distribute
                                            </a>
                                        }
                                        @if (canManage)
                                        {
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-secondary" title="Edit">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        @if (totalPages > 1)
        {
            <div class="card-footer bg-white d-flex justify-content-between align-items-center py-3">
                <small class="text-muted">Showing page @currentPage of @totalPages (@totalCount total items)</small>
                <nav>
                    <ul class="pagination pagination-sm mb-0">
                        @for (int p = 1; p <= totalPages; p++)
                        {
                            <li class="page-item @(p == currentPage ? "active" : "")">
                                <a class="page-link" asp-action="Index" asp-route-page="@p" asp-route-classification="@classification" asp-route-category="@category" asp-route-status="@status" asp-route-search="@search">@p</a>
                            </li>
                        }
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>
