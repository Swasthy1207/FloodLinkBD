@model FloodLink.Models.HighRiskArea

@{
    ViewData["Title"] = "Edit Area: " + Model.AreaName;
    var riskLevels = ViewBag.RiskLevels as string[] ?? Array.Empty<string>();
    var accessibilities = ViewBag.Accessibilities as string[] ?? Array.Empty<string>();
    var orgs = ViewBag.Organizations as List<FloodLink.Models.Organization> ?? new List<FloodLink.Models.Organization>();
}

<div class="container mt-4 mb-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-secondary text-white py-3">
                    <h5 class="mb-0"><i class="bi bi-pencil-square me-2"></i> Edit High-Risk Area</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Edit" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <div class="mb-3">
                            <label asp-for="AreaName" class="form-label fw-bold"></label>
                            <input asp-for="AreaName" class="form-control" />
                            <span asp-validation-for="AreaName" class="text-danger small"></span>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="DistrictOrUpazila" class="form-label fw-bold">District / Upazila</label>
                                <input asp-for="DistrictOrUpazila" class="form-control" />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="UnionOrWard" class="form-label fw-bold">Union / Ward</label>
                                <input asp-for="UnionOrWard" class="form-control" />
                            </div>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-4">
                                <label asp-for="RiskLevel" class="form-label fw-bold"></label>
                                <select asp-for="RiskLevel" class="form-select">
                                    @foreach (var r in riskLevels)
                                    {
                                        <option value="@r">@r Risk</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="Accessibility" class="form-label fw-bold"></label>
                                <select asp-for="Accessibility" class="form-select">
                                    @foreach (var a in accessibilities)
                                    {
                                        <option value="@a">@a</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="PopulationEstimate" class="form-label fw-bold">Population Est.</label>
                                <input asp-for="PopulationEstimate" type="number" min="0" class="form-control" />
                            </div>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-8">
                                <label asp-for="OrganizationId" class="form-label fw-bold">Organization</label>
                                <select asp-for="OrganizationId" class="form-select">
                                    <option value="">-- Multi-Organization Public Record --</option>
                                    @foreach (var o in orgs)
                                    {
                                        <option value="@o.Id">@o.OrganizationName</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-4 d-flex align-items-center">
                                <div class="form-check mt-3">
                                    <input asp-for="IsActive" class="form-check-input" />
                                    <label asp-for="IsActive" class="form-check-label fw-semibold">Active Danger Area</label>
                                </div>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="TerrainAndHazardNotes" class="form-label fw-bold">Terrain, Water Level & Special Hazards</label>
                            <textarea asp-for="TerrainAndHazardNotes" rows="4" class="form-control"></textarea>
                        </div>

                        <div class="d-flex justify-content-between align-items-center">
                            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancel</a>
                            <button type="submit" class="btn btn-primary px-4"><i class="bi bi-check2 me-1"></i> Update Area Record</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
