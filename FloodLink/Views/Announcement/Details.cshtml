@model FloodLink.Models.Announcement

@{
    ViewData["Title"] = Model.Title;
    bool canManage = User.IsInRole("Super Admin") || User.IsInRole("Admin") || User.IsInRole("Coordinator") || User.IsInRole("Organization Admin") || User.IsInRole("Organization");

    string UrgencyBadge(string u) => u switch
    {
        "Critical" => "bg-danger text-white",
        "High" => "bg-warning text-dark",
        "Normal" => "bg-primary text-white",
        "Low" => "bg-secondary text-white",
        _ => "bg-info text-dark"
    };

    string CategoryIcon(string c) => c switch
    {
        "Flood Warning" => "bi-water text-danger",
        "Shelter Opening" => "bi-door-open-fill text-success",
        "Shelter Closing" => "bi-door-closed-fill text-secondary",
        "Volunteer Recruitment" => "bi-people-fill text-primary",
        "Relief Distribution Schedule" => "bi-calendar-check-fill text-info",
        "Safety Instructions" => "bi-shield-check text-warning",
        _ => "bi-megaphone-fill text-primary"
    };
}

<div class="container mt-4 mb-5">
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index">Announcements</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.Title</li>
        </ol>
    </nav>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row justify-content-center">
        <div class="col-lg-9">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                    <div>
                        <span class="badge bg-light text-dark border me-1"><i class="bi @CategoryIcon(Model.Category) me-1"></i> @Model.Category</span>
                        <span class="badge @UrgencyBadge(Model.UrgencyLevel)">@Model.UrgencyLevel Urgency</span>
                        @if (!Model.IsActive)
                        {
                            <span class="badge bg-secondary ms-1">Inactive</span>
                        }
                    </div>
                    @if (canManage)
                    {
                        <div class="btn-group btn-group-sm">
                            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-secondary">
                                <i class="bi bi-pencil me-1"></i> Edit
                            </a>
                            <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-inline" onsubmit="return confirm('Delete this announcement?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-danger">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </div>
                    }
                </div>
                <div class="card-body p-4">
                    <h2 class="fw-bold mb-3">@Model.Title</h2>

                    <div class="d-flex flex-wrap gap-3 text-muted small mb-4 pb-3 border-bottom">
                        <div><i class="bi bi-clock me-1"></i> Published: <strong>@Model.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy HH:mm")</strong></div>
                        <div><i class="bi bi-building me-1"></i> By: <strong>@(Model.Organization?.OrganizationName ?? "FloodLink Central")</strong></div>
                        @if (!string.IsNullOrEmpty(Model.TargetArea))
                        {
                            <div class="text-danger fw-bold"><i class="bi bi-geo-alt-fill me-1"></i> Target Area: @Model.TargetArea</div>
                        }
                        @if (Model.ExpiresAt.HasValue)
                        {
                            <div><i class="bi bi-hourglass-split me-1"></i> Valid Until: @Model.ExpiresAt.Value.ToLocalTime().ToString("MMM dd, yyyy HH:mm")</div>
                        }
                    </div>

                    <div class="lead fs-6 text-dark" style="white-space: pre-line; line-height: 1.8;">
                        @Model.Content
                    </div>

                    <div class="bg-light p-3 rounded mt-4 d-flex justify-content-between align-items-center">
                        <small class="text-muted">
                            <i class="bi bi-info-circle me-1"></i> This notice is visible to all registered volunteers, citizens, and coordinators.
                        </small>
                        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                            &larr; Back to Announcements
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
