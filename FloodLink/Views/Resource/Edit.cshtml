@model FloodLink.Models.Resource

@{
    ViewData["Title"] = "Edit " + Model.ResourceName;
    var categories = ViewBag.Categories as string[] ?? Array.Empty<string>();
    var units = ViewBag.Units as string[] ?? Array.Empty<string>();
    var statuses = ViewBag.Statuses as string[] ?? Array.Empty<string>();
    var orgs = ViewBag.Organizations as List<FloodLink.Models.Organization> ?? new List<FloodLink.Models.Organization>();
}

<div class="container mt-4 mb-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-secondary text-white py-3">
                    <h5 class="mb-0"><i class="bi bi-pencil-square me-2"></i> Edit Resource / Equipment</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Edit" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <div class="mb-3">
                            <label asp-for="ResourceName" class="form-label fw-bold"></label>
                            <input asp-for="ResourceName" class="form-control" />
                            <span asp-validation-for="ResourceName" class="text-danger small"></span>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="ItemClassification" class="form-label fw-bold"></label>
                                <select asp-for="ItemClassification" class="form-select">
                                    <option value="Resource">Resource (Relief Supplies)</option>
                                    <option value="Equipment">Equipment (Rescue / Vehicles)</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Category" class="form-label fw-bold"></label>
                                <select asp-for="Category" class="form-select">
                                    @foreach (var c in categories)
                                    {
                                        <option value="@c">@c</option>
                                    }
                                </select>
                            </div>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-4">
                                <label asp-for="Quantity" class="form-label fw-bold"></label>
                                <input asp-for="Quantity" type="number" min="0" class="form-control" />
                                <span asp-validation-for="Quantity" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="Unit" class="form-label fw-bold"></label>
                                <select asp-for="Unit" class="form-select">
                                    @foreach (var u in units)
                                    {
                                        <option value="@u">@u</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="Status" class="form-label fw-bold"></label>
                                <select asp-for="Status" class="form-select">
                                    @foreach (var s in statuses)
                                    {
                                        <option value="@s">@s</option>
                                    }
                                </select>
                            </div>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="Location" class="form-label fw-bold"></label>
                                <input asp-for="Location" class="form-control" />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="OrganizationId" class="form-label fw-bold">Organization</label>
                                <select asp-for="OrganizationId" class="form-select">
                                    <option value="">-- General / Multi-Org Inventory --</option>
                                    @foreach (var o in orgs)
                                    {
                                        <option value="@o.Id">@o.OrganizationName</option>
                                    }
                                </select>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Notes" class="form-label fw-bold"></label>
                            <textarea asp-for="Notes" rows="3" class="form-control"></textarea>
                        </div>

                        <div class="d-flex justify-content-between align-items-center">
                            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancel</a>
                            <button type="submit" class="btn btn-primary px-4"><i class="bi bi-check2 me-1"></i> Update Item</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
