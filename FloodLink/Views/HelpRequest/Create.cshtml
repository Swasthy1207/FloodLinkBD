@model FloodLink.Models.HelpRequestViewModel

@{
    ViewData["Title"] = "Submit Help Request";
    var categories = (string[])ViewBag.Categories;
}

<div class="container mt-4 mb-5">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-md-10">

            <nav aria-label="breadcrumb" class="mb-3">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item">
                        <a asp-controller="Dashboard" asp-action="Index">Dashboard</a>
                    </li>
                    <li class="breadcrumb-item">
                        <a asp-controller="HelpRequest" asp-action="MyRequests">My Requests</a>
                    </li>
                    <li class="breadcrumb-item active" aria-current="page">Submit Request</li>
                </ol>
            </nav>

            <div class="card shadow-sm">
                <div class="card-header border-bottom py-3">
                    <h4 class="mb-0">
                        <i class="bi bi-exclamation-triangle-fill text-warning me-2"></i>
                        Submit Help Request
                    </h4>
                    <p class="text-muted mb-0 small mt-1">
                        Fill in the details below to request emergency assistance.
                        All fields marked <span class="text-danger">*</span> are required.
                    </p>
                </div>

                <div class="card-body p-4">

                    <form asp-controller="HelpRequest"
                          asp-action="Create"
                          method="post"
                          enctype="multipart/form-data">

                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly"
                             class="alert alert-danger py-2 mb-3"></div>

                        <!-- Title -->
                        <div class="mb-3">
                            <label asp-for="Title" class="form-label fw-semibold">
                                Request Title <span class="text-danger">*</span>
                            </label>
                            <input asp-for="Title"
                                   class="form-control"
                                   placeholder="e.g. Urgent food needed for flood victims"
                                   maxlength="150" />
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>

                        <!-- Affected Person Name (Community Reporter only) -->
                        @if (User.IsInRole("Community Reporter"))
                        {
                            <div class="mb-3">
                                <label asp-for="AffectedPersonName" class="form-label fw-semibold"></label>
                                <input asp-for="AffectedPersonName"
                                       class="form-control"
                                       placeholder="e.g. Rahim Uddin (Optional)"
                                       maxlength="150" />
                                <span asp-validation-for="AffectedPersonName" class="text-danger small"></span>
                            </div>
                        }

                        <!-- Description -->
                        <div class="mb-3">
                            <label asp-for="Description" class="form-label fw-semibold">
                                Description <span class="text-danger">*</span>
                            </label>
                            <textarea asp-for="Description"
                                      class="form-control"
                                      rows="4"
                                      placeholder="Describe the situation and the help you need in detail"
                                      maxlength="2000"></textarea>
                            <div class="form-text text-end">
                                <span id="descCharCount">0</span>/2000
                            </div>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        <!-- Category -->
                        <div class="mb-3">
                            <label asp-for="Category" class="form-label fw-semibold">
                                Help Category <span class="text-danger">*</span>
                            </label>
                            <select asp-for="Category" class="form-select">
                                <option value="">-- Select Category --</option>
                                @foreach (var cat in categories)
                                {
                                    <option value="@cat">@cat</option>
                                }
                            </select>
                            <span asp-validation-for="Category" class="text-danger small"></span>
                        </div>

                        <!-- Number of People + Location -->
                        <div class="row g-3 mb-3">
                            <div class="col-md-4">
                                <label asp-for="NumberOfPeople" class="form-label fw-semibold">
                                    Affected People <span class="text-danger">*</span>
                                </label>
                                <input asp-for="NumberOfPeople"
                                       type="number"
                                       class="form-control"
                                       min="1"
                                       max="100000"
                                       placeholder="e.g. 15" />
                                <span asp-validation-for="NumberOfPeople" class="text-danger small"></span>
                            </div>
                            <div class="col-md-8">
                                <label asp-for="Location" class="form-label fw-semibold">
                                    Location <span class="text-danger">*</span>
                                </label>
                                <input asp-for="Location"
                                       id="locationInput"
                                       class="form-control"
                                       placeholder="e.g. Ward 5, Feni Sadar, Feni"
                                       maxlength="300" />
                                <span asp-validation-for="Location" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Contact Information -->
                        <div class="mb-3">
                            <label asp-for="ContactInformation" class="form-label fw-semibold">
                                Contact Information <span class="text-danger">*</span>
                            </label>
                            <input asp-for="ContactInformation"
                                   class="form-control"
                                   placeholder="e.g. 01712345678 or contact name and phone"
                                   maxlength="200" />
                            <span asp-validation-for="ContactInformation" class="text-danger small"></span>
                        </div>

                        <!-- Map Picker (OpenStreetMap + Leaflet) -->
                        <div class="mb-4">
                            <label class="form-label fw-semibold">
                                <i class="bi bi-geo-alt-fill text-primary me-1"></i>
                                Pin Location on Map <span class="text-muted fw-normal small">(optional)</span>
                            </label>
                            <div class="d-flex gap-2 mb-2">
                                <button type="button" id="detectLocationBtn"
                                        class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-crosshair me-1"></i>Use My Location
                                </button>
                                <button type="button" id="clearMapBtn"
                                        class="btn btn-sm btn-outline-secondary">
                                    <i class="bi bi-x-circle me-1"></i>Clear
                                </button>
                            </div>
                            <div id="createMap"
                                 style="height:300px; border-radius:0.5rem; border:1px solid #dee2e6;"
                                 class="mb-2"></div>
                            <div class="row g-2">
                                <div class="col-6">
                                    <label class="form-label small text-muted">Latitude</label>
                                    <input asp-for="Latitude" type="number" step="any"
                                           id="latInput" class="form-control form-control-sm"
                                           placeholder="e.g. 23.8103" readonly />
                                </div>
                                <div class="col-6">
                                    <label class="form-label small text-muted">Longitude</label>
                                    <input asp-for="Longitude" type="number" step="any"
                                           id="lngInput" class="form-control form-control-sm"
                                           placeholder="e.g. 90.4125" readonly />
                                </div>
                            </div>
                            <div class="form-text">Click the map to place a pin at the exact location.</div>
                        </div>

                        <!-- Multiple Image Upload -->
                        <div class="mb-4">
                            <label class="form-label fw-semibold">
                                <i class="bi bi-images me-1"></i>
                                Photos <span class="text-muted fw-normal small">(optional, up to 5)</span>
                            </label>
                            <input name="ImageFiles"
                                   type="file"
                                   id="imageFilesInput"
                                   class="form-control"
                                   accept="image/jpeg,image/jpg,image/png,image/webp"
                                   multiple />
                            <div class="form-text">JPG, PNG, or WEBP. Maximum 5 MB per file. Up to 5 files.</div>
                            <span asp-validation-for="ImageFiles" class="text-danger small"></span>

                            <!-- Image previews grid -->
                            <div id="imagePreviewGrid" class="d-flex flex-wrap gap-2 mt-3"></div>
                        </div>

                        <!-- Submit -->
                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                            <a asp-controller="HelpRequest"
                               asp-action="MyRequests"
                               class="btn btn-outline-secondary">
                                Cancel
                            </a>
                            <button type="submit" class="btn btn-primary px-4">
                                <i class="bi bi-send-fill me-1"></i>Submit Help Request
                            </button>
                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }

    <!-- Leaflet for map picker -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

    <script>
        // ── Description character counter ──────────────────────────────────
        const descArea  = document.querySelector('textarea[name="Description"]');
        const charCount = document.getElementById('descCharCount');
        if (descArea) {
            const update = () => charCount.textContent = descArea.value.length;
            descArea.addEventListener('input', update);
            update();
        }

        // ── Multiple image preview ─────────────────────────────────────────
        const imageInput   = document.getElementById('imageFilesInput');
        const previewGrid  = document.getElementById('imagePreviewGrid');
        const MAX_FILES    = 5;
        const ALLOWED_MIME = ['image/jpeg', 'image/jpg', 'image/png', 'image/webp'];
        const MAX_BYTES    = 5 * 1024 * 1024;

        imageInput.addEventListener('change', function () {
            previewGrid.innerHTML = '';
            const files = Array.from(this.files);

            if (files.length > MAX_FILES) {
                alert('You can select a maximum of 5 images.');
                this.value = '';
                return;
            }

            files.forEach((file, idx) => {
                if (!ALLOWED_MIME.includes(file.type)) {
                    alert(`${file.name}: Only JPG, PNG, WEBP allowed.`);
                    return;
                }
                if (file.size > MAX_BYTES) {
                    alert(`${file.name}: File must be under 5 MB.`);
                    return;
                }
                const reader = new FileReader();
                reader.onload = e => {
                    const wrapper = document.createElement('div');
                    wrapper.className = 'position-relative';
                    wrapper.style.cssText = 'width:100px;height:100px;';
                    wrapper.innerHTML = `
                        <img src="${e.target.result}" alt="Preview ${idx+1}"
                             class="img-thumbnail w-100 h-100 object-fit-cover" />
                        <span class="badge bg-dark position-absolute bottom-0 start-0 w-100 text-truncate small"
                              style="font-size:0.6rem;">${file.name}</span>`;
                    previewGrid.appendChild(wrapper);
                };
                reader.readAsDataURL(file);
            });
        });

        // ── Leaflet Map Picker ─────────────────────────────────────────────
        const latInput = document.getElementById('latInput');
        const lngInput = document.getElementById('lngInput');
        // Bangladesh center
        const defaultLat = 23.8103, defaultLng = 90.4125;

        const map = L.map('createMap').setView([defaultLat, defaultLng], 7);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '© OpenStreetMap contributors',
            maxZoom: 19
        }).addTo(map);

        let marker = null;

        function setMarker(lat, lng) {
            lat = parseFloat(lat.toFixed(6));
            lng = parseFloat(lng.toFixed(6));
            if (marker) { marker.setLatLng([lat, lng]); }
            else {
                marker = L.marker([lat, lng], { draggable: true }).addTo(map);
                marker.on('dragend', e => {
                    const pos = e.target.getLatLng();
                    latInput.value = pos.lat.toFixed(6);
                    lngInput.value = pos.lng.toFixed(6);
                });
            }
            latInput.value = lat;
            lngInput.value = lng;
            map.setView([lat, lng], 13);
        }

        map.on('click', e => setMarker(e.latlng.lat, e.latlng.lng));

        document.getElementById('detectLocationBtn').addEventListener('click', function () {
            if (!navigator.geolocation) { alert('Geolocation not supported.'); return; }
            navigator.geolocation.getCurrentPosition(
                pos => setMarker(pos.coords.latitude, pos.coords.longitude),
                ()  => alert('Could not detect location. Please pin manually.')
            );
        });

        document.getElementById('clearMapBtn').addEventListener('click', function () {
            if (marker) { map.removeLayer(marker); marker = null; }
            latInput.value = '';
            lngInput.value = '';
        });
    </script>
}
