@{
    ViewData["Title"] = "Help Coordination Dashboard";

    var needs =
        ViewBag.Needs as IEnumerable<FloodLink.Models.OrganizationHelpNeed>
        ?? Enumerable.Empty<FloodLink.Models.OrganizationHelpNeed>();

    var offers =
        ViewBag.Offers as IEnumerable<FloodLink.Models.OrganizationHelpOffer>
        ?? Enumerable.Empty<FloodLink.Models.OrganizationHelpOffer>();
}

<div class="container py-4">

    <div class="mb-4">
        <h2>Help Coordination Dashboard</h2>

        <p class="text-muted">
            Monitor organization help needs and offers.
            Coordinators can facilitate connections between organizations.
        </p>
    </div>


    <div class="row g-3 mb-4">

        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h6>Total Help Needs</h6>
                    <h2>@needs.Count()</h2>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h6>Total Offers</h6>
                    <h2>@offers.Count()</h2>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h6>Pending Offers</h6>
                    <h2>
                        @offers.Count(o => o.Status == "Pending")
                    </h2>
                </div>
            </div>
        </div>

    </div>


    <div class="card shadow-sm mb-4">

        <div class="card-header">
            <h4>All Organization Help Needs</h4>
        </div>

        <div class="card-body table-responsive">

            <table class="table table-hover">

                <thead>
                    <tr>
                        <th>Need</th>
                        <th>Organization</th>
                        <th>Help Type</th>
                        <th>Priority</th>
                        <th>Status</th>
                        <th>Location</th>
                        <th></th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var need in needs)
                    {
                        <tr>

                            <td>
                                @need.Title
                            </td>

                            <td>
                                @need.Organization?.OrganizationName
                            </td>

                            <td>
                                @need.HelpType
                            </td>

                            <td>
                                @need.Priority
                            </td>

                            <td>
                                @need.Status
                            </td>

                            <td>
                                @need.Location
                            </td>

                            <td>
                                <a asp-action="Details"
                                   asp-route-id="@need.Id"
                                   class="btn btn-sm btn-outline-primary">
                                    Details
                                </a>
                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>


    <div class="card shadow-sm">

        <div class="card-header">
            <h4>All Help Offers</h4>
        </div>

        <div class="card-body table-responsive">

            <table class="table table-hover">

                <thead>
                    <tr>
                        <th>Request</th>
                        <th>Requesting Organization</th>
                        <th>Offering Organization</th>
                        <th>Help Offered</th>
                        <th>Status</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var offer in offers)
                    {
                        <tr>

                            <td>
                                @offer.HelpNeed?.Title
                            </td>

                            <td>
                                @offer.HelpNeed?.Organization?.OrganizationName
                            </td>

                            <td>
                                @offer.OfferingOrganization?.OrganizationName
                            </td>

                            <td>
                                @offer.OfferedHelpType
                            </td>

                            <td>
                                @offer.Status
                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>