@model FloodLink.Models.ResourceDistribution

@{
    var resource = ViewBag.Resource as FloodLink.Models.Resource;
    ViewData["Title"] = "Distribute " + (resource?.ResourceName ?? "Item");
    var operations = ViewBag.Operations as List<FloodLink.Models.DisasterOperation> ?? new List<FloodLink.Models.DisasterOperation>();
}

<div class="container mt-4 mb-5">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-success text-white py-3">
                    <h5 class="mb-0"><i class="bi bi-box-arrow-right me-2"></i> Record Distribution / Deployment</h5>
                </div>
                <div class="card-body p-4">
                    @if (resource != null)
                    {
                        <div class="alert alert-info d-flex justify-content-between align-items-center mb-4">
                            <div>
                                <h6 class="mb-0 fw-bold">@resource.ResourceName</h6>
                                <small>Category: @resource.Category | In Stock: <strong>@resource.Quantity @resource.Unit</strong></small>
                            </div>
                            <span class="badge bg-primary">@resource.ItemClassification</span>
                        </div>
                    }

                    <form asp-action="Distribute" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="ResourceId" />
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <div class="mb-3">
                            <label asp-for="Quantity" class="form-label fw-bold">Quantity to Distribute / Deploy (@(resource?.Unit ?? "units"))</label>
                            <input asp-for="Quantity" type="number" min="1" max="@(resource?.ItemClassification == "Resource" ? resource?.Quantity : int.MaxValue)" class="form-control" />
                            <span asp-validation-for="Quantity" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="DistributedTo" class="form-label fw-bold">Destination / Beneficiary (Village, Shelter, Family, Union)</label>
                            <input asp-for="DistributedTo" class="form-control" placeholder="e.g. Char Fasson Evacuation Camp, Village Shantinagar, Shelter #2" />
                            <span asp-validation-for="DistributedTo" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="DisasterOperationId" class="form-label fw-bold">Linked Relief Operation (Optional)</label>
                            <select asp-for="DisasterOperationId" class="form-select">
                                <option value="">-- Standalone Distribution --</option>
                                @foreach (var op in operations)
                                {
                                    <option value="@op.DisasterOperationId">@op.OperationName (@(op.Location ?? "General"))</option>
                                }
                            </select>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Remarks" class="form-label fw-bold">Remarks / Notes</label>
                            <textarea asp-for="Remarks" rows="3" class="form-control" placeholder="Distribution vehicle used, coordinator on site, recipient contact..."></textarea>
                        </div>

                        <div class="d-flex justify-content-end gap-2">
                            <a asp-action="Details" asp-route-id="@Model.ResourceId" class="btn btn-outline-secondary">Cancel</a>
                            <button type="submit" class="btn btn-success px-4"><i class="bi bi-check-circle me-1"></i> Confirm Distribution</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
