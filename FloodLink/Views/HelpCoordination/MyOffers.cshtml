@model IEnumerable<FloodLink.Models.OrganizationHelpOffer>

@{
    ViewData["Title"] = "My Help Offers";
}

<div class="container py-4">

    <h2>My Help Offers</h2>

    <p class="text-muted">
        Help offers submitted by your organization.
    </p>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }


    @if (!Model.Any())
    {
        <div class="alert alert-info">
            Your organization has not submitted any help offers yet.
        </div>
    }
    else
    {
        <div class="table-responsive">

            <table class="table table-bordered table-hover">

                <thead class="table-light">

                    <tr>
                        <th>Help Need</th>
                        <th>Requesting Organization</th>
                        <th>Help Offered</th>
                        <th>Quantity</th>
                        <th>Status</th>
                        <th>Date</th>
                        <th>Action</th>
                    </tr>

                </thead>

                <tbody>

                    @foreach (var offer in Model)
                    {
                        <tr>

                            <td>
                                @offer.HelpNeed?.Title
                            </td>

                            <td>
                                @offer.HelpNeed?.Organization?.OrganizationName
                            </td>

                            <td>
                                @offer.OfferedHelpType
                            </td>

                            <td>
                                @offer.OfferedQuantity
                            </td>

                            <td>

                                @if (offer.Status == "Accepted")
                                {
                                    <span class="badge bg-success">
                                        Accepted
                                    </span>
                                }
                                else if (offer.Status == "Rejected")
                                {
                                    <span class="badge bg-danger">
                                        Rejected
                                    </span>
                                }
                                else if (offer.Status == "Pending")
                                {
                                    <span class="badge bg-warning text-dark">
                                        Pending
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        @offer.Status
                                    </span>
                                }

                            </td>

                            <td>
                                @offer.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")
                            </td>

                            <td>

                                <a asp-action="Details"
                                   asp-route-id="@offer.HelpNeedId"
                                   class="btn btn-sm btn-outline-primary">
                                    View
                                </a>

                                @if (offer.Status == "Pending")
                                {
                                    <form asp-action="WithdrawOffer"
                                          method="post"
                                          class="d-inline">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="id"
                                               value="@offer.HelpOfferId" />

                                        <button type="submit"
                                                class="btn btn-sm btn-outline-danger">
                                            Withdraw
                                        </button>

                                    </form>
                                }

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }

</div>