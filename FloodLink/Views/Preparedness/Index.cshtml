@model IEnumerable<FloodLink.Models.PreparednessActivity>

@{
    ViewData["Title"] = "Pre-Disaster Preparedness";
    string activityType = ViewBag.ActivityType as string ?? "";
    string status = ViewBag.Status as string ?? "";
    string search = ViewBag.Search as string ?? "";
    int currentPage = (int)(ViewBag.CurrentPage ?? 1);
    int totalPages = (int)(ViewBag.TotalPages ?? 1);
    int totalCount = (int)(ViewBag.TotalCount ?? 0);
    var activityTypes = ViewBag.ActivityTypes as string[] ?? Array.Empty<string>();
    var statuses = ViewBag.Statuses as string[] ?? Array.Empty<string>();
    bool canManage = User.IsInRole("Super Admin") || User.IsInRole("Admin") || User.IsInRole("Coordinator") || User.IsInRole("Organization Admin") || User.IsInRole("Organization");

    string StatusBadge(string s) => s switch
    {
        "Completed" => "bg-success text-white",
        "In Progress" => "bg-primary text-white",
        "Planned" => "bg-info text-dark",
        "Postponed" => "bg-warning text-dark",
        "Cancelled" => "bg-danger text-white",
        _ => "bg-secondary text-white"
    };

    string TypeIcon(string t) => t switch
    {
        "Volunteer Training" => "bi-person-badge text-primary",
        "Emergency Drill" => "bi-alarm-fill text-danger",
        "Awareness Campaign" => "bi-megaphone text-warning",
        "Meeting Schedule" => "bi-calendar-event text-info",
        "Resource Preparation" => "bi-box-seam text-success",
        "Shelter Update" => "bi-building-gear text-secondary",
        _ => "bi-shield-check text-primary"
    };
}

<div class="container mt-4 mb-5">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
        <div>
            <h2 class="fw-bold mb-1">🛡️ Pre-Disaster Preparedness Module</h2>
            <p class="text-muted mb-0">Pre-season readiness: Volunteer Training, Emergency Drills, Awareness Campaigns, and Shelter Updates</p>
        </div>
        @if (canManage)
        {
            <a asp-action="Create" class="btn btn-primary shadow-sm">
                <i class="bi bi-plus-circle me-1"></i> Plan Preparedness Activity
            </a>
        }
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Search & Filter Card -->
    <div class="card shadow-sm border-0 mb-4 bg-light">
        <div class="card-body p-3">
            <form method="get" asp-action="Index" class="row g-2 align-items-center">
                <div class="col-md-4">
                    <input type="text" name="search" value="@search" class="form-control" placeholder="Search activities, locations, notes..." />
                </div>
                <div class="col-md-3">
                    <select name="activityType" class="form-select">
                        <option value="">All Activity Types</option>
                        @foreach (var t in activityTypes)
                        {
                            <option value="@t" selected="@(activityType == t)">@t</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <select name="status" class="form-select">
                        <option value="">All Statuses</option>
                        @foreach (var s in statuses)
                        {
                            <option value="@s" selected="@(status == s)">@s</option>
                        }
                    </select>
                </div>
                <div class="col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-secondary w-100"><i class="bi bi-filter"></i> Filter</button>
                    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-x"></i></a>
                </div>
            </form>
        </div>
    </div>

    <!-- Table of Activities -->
    <div class="card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Activity Title</th>
                        <th>Type</th>
                        <th>Scheduled Date</th>
                        <th>Location</th>
                        <th>Participants</th>
                        <th>Status</th>
                        <th>Organization</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">
                                <i class="bi bi-shield-slash fs-1 d-block mb-2"></i>
                                No preparedness activities recorded yet.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var a in Model)
                        {
                            <tr>
                                <td>
                                    <div class="fw-bold">
                                        <a asp-action="Details" asp-route-id="@a.Id" class="text-dark text-decoration-none">
                                            @a.Title
                                        </a>
                                    </div>
                                    <small class="text-muted text-truncate d-inline-block" style="max-width: 250px;">@a.Description</small>
                                </td>
                                <td>
                                    <i class="bi @TypeIcon(a.ActivityType) me-1"></i>
                                    <span class="badge bg-light text-dark border">@a.ActivityType</span>
                                </td>
                                <td>
                                    <span class="fw-semibold">@a.ScheduledDate.ToLocalTime().ToString("MMM dd, yyyy")</span><br />
                                    <small class="text-muted">@a.ScheduledDate.ToLocalTime().ToString("HH:mm")</small>
                                </td>
                                <td>
                                    <small><i class="bi bi-geo-alt text-muted"></i> @(a.Location ?? "Not specified")</small>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">@a.ParticipantCount attendees</span>
                                </td>
                                <td>
                                    <span class="badge @StatusBadge(a.Status)">@a.Status</span>
                                </td>
                                <td>
                                    <small class="fw-semibold">@(a.Organization?.OrganizationName ?? "Central Coordination")</small>
                                </td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Details" asp-route-id="@a.Id" class="btn btn-outline-secondary">Details</a>
                                        @if (canManage)
                                        {
                                            <a asp-action="Edit" asp-route-id="@a.Id" class="btn btn-outline-secondary">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        @if (totalPages > 1)
        {
            <div class="card-footer bg-white d-flex justify-content-between align-items-center py-3">
                <small class="text-muted">Showing page @currentPage of @totalPages (@totalCount total activities)</small>
                <nav>
                    <ul class="pagination pagination-sm mb-0">
                        @for (int p = 1; p <= totalPages; p++)
                        {
                            <li class="page-item @(p == currentPage ? "active" : "")">
                                <a class="page-link" asp-action="Index" asp-route-page="@p" asp-route-activityType="@activityType" asp-route-status="@status" asp-route-search="@search">@p</a>
                            </li>
                        }
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>
