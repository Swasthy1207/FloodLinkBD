@model IEnumerable<FloodLink.Models.DisasterOperation>

@{
    ViewData["Title"] = "Our Activities";
    var myOrgName = ViewBag.MyOrgName as string;
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-diagram-3 me-2 text-fl-green"></i>Our Relief Activities
            </h2>
            @if (!string.IsNullOrEmpty(myOrgName))
            {
                <p class="text-muted mb-0">@myOrgName</p>
            }
        </div>
        <a asp-action="CreateOperation" class="btn btn-fl-green">
            <i class="bi bi-plus-circle me-1"></i>Post New Activity
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle me-2"></i>No activities posted yet.
            <a asp-action="CreateOperation" class="alert-link ms-1">Post your first activity →</a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Activity</th>
                        <th>Type</th>
                        <th>Location</th>
                        <th>Status</th>
                        <th>Started</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var op in Model)
                    {
                        var badgeClass = op.Status switch {
                            "Active"    => "bg-warning text-dark",
                            "Completed" => "bg-fl-green text-white",
                            "Cancelled" => "bg-danger text-white",
                            _           => "bg-secondary text-white"
                        };
                        <tr>
                            <td>
                                <strong>@op.OperationName</strong>
                                @if (!string.IsNullOrEmpty(op.Description))
                                {
                                    <div class="small text-muted">@(op.Description.Length > 80 ? op.Description[..80] + "…" : op.Description)</div>
                                }
                            </td>
                            <td class="small">@op.DisasterType</td>
                            <td class="small">@op.Location</td>
                            <td><span class="badge @badgeClass">@op.Status</span></td>
                            <td class="small text-muted">@op.StartDate.ToString("dd MMM yyyy")</td>
                            <td>
                                <a asp-action="OperationDetails" asp-route-id="@op.DisasterOperationId"
                                   class="btn btn-outline-secondary btn-sm">
                                    <i class="bi bi-eye"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

</div>
