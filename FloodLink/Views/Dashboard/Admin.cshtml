@{
    ViewData["Title"] = "Super Admin Dashboard";

    var fullName = User.FindFirst("FullName")?.Value ?? User.Identity?.Name;
    var email = User.Identity?.Name;
}

<div class="container py-5">

    <div class="mb-4">
        <div class="d-flex align-items-center gap-2">
            <h2>Super Admin Dashboard</h2>
            <span class="badge bg-danger">Super Admin</span>
        </div>
        <p class="text-muted">
            Welcome, <strong>@fullName</strong> (@email).
        </p>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm p-3 bg-light">
                <div class="card-body py-2">
                    <span class="text-muted small">Total Help Requests</span>
                    <h3 class="fw-bold mb-0 text-primary">@ViewBag.TotalRequests</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm p-3 bg-light">
                <div class="card-body py-2">
                    <span class="text-muted small">Pending Requests</span>
                    <h3 class="fw-bold mb-0 text-warning">@ViewBag.PendingRequests</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm p-3 bg-light">
                <div class="card-body py-2">
                    <span class="text-muted small">In Progress</span>
                    <h3 class="fw-bold mb-0 text-info">@ViewBag.InProgressRequests</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm p-3 bg-light">
                <div class="card-body py-2">
                    <span class="text-muted small">Completed</span>
                    <h3 class="fw-bold mb-0 text-success">@ViewBag.CompletedRequests</h3>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">

        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm p-3 border-start border-4 border-primary">
                <div class="card-body d-flex flex-column">
                    <div class="d-flex align-items-center mb-2">
                        <span class="fs-3 text-primary me-2"><i class="bi bi-people-fill"></i></span>
                        <h4 class="mb-0">Users & Roles</h4>
                    </div>
                    <p class="text-muted flex-grow-1">
                        Manage registered users, verification statuses, and role privileges across the 6 system roles.
                    </p>
                    <a asp-controller="Account" asp-action="Users" class="btn btn-primary">
                        <i class="bi bi-person-gear me-1"></i> User Management
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm p-3 border-start border-4 border-success">
                <div class="card-body d-flex flex-column">
                    <div class="d-flex align-items-center mb-2">
                        <span class="fs-3 text-success me-2"><i class="bi bi-building"></i></span>
                        <h4 class="mb-0">Organizations</h4>
                    </div>
                    <p class="text-muted flex-grow-1">
                        Oversee relief organizations, agencies, verification approvals, and regional operational centers.
                    </p>
                    <a asp-controller="Organization" asp-action="Index" class="btn btn-primary">
                        <i class="bi bi-buildings me-1"></i> Manage Organizations
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm p-3 border-start border-4 border-info">
                <div class="card-body d-flex flex-column">
                    <div class="d-flex align-items-center mb-2">
                        <span class="fs-3 text-info me-2"><i class="bi bi-life-preserver"></i></span>
                        <h4 class="mb-0">All Help Requests</h4>
                    </div>
                    <p class="text-muted flex-grow-1">
                        Monitor, audit, and analyze citizen help requests, response coordination, and status tracking.
                    </p>
                    <a asp-controller="HelpRequest" asp-action="AllRequests" class="btn btn-primary">
                        <i class="bi bi-card-checklist me-1"></i> View All Requests
                    </a>
                </div>
            </div>
        </div>

    </div>

  

</div>