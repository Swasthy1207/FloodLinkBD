@model FloodLink.Models.DisasterOperation

@{
    ViewData["Title"] = "Post New Activity";
    var myOrgId   = ViewBag.MyOrgId as int?;
    var myOrgName = ViewBag.MyOrgName as string;
    var orgs      = ViewBag.Organizations as List<FloodLink.Models.Organization>;
}

<div class="container py-4" style="max-width:700px">

    <div class="mb-4">
        <h2 class="fw-bold mb-1">
            <i class="bi bi-plus-circle me-2 text-fl-green"></i>Post New Relief Activity
        </h2>
        @if (!string.IsNullOrEmpty(myOrgName))
        {
            <p class="text-muted mb-0">Organization: <strong>@myOrgName</strong></p>
        }
        else
        {
            <p class="text-muted mb-0">This activity will be publicly visible once created.</p>
        }
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">

            <form asp-action="CreateOperation" method="post">
                @Html.AntiForgeryToken()

                @if (myOrgId.HasValue)
                {
                    <input type="hidden" name="CreatedByOrganizationId" value="@myOrgId" />
                }
                else if (orgs != null)
                {
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Lead Organization</label>
                        <select name="CreatedByOrganizationId" class="form-select" required>
                            <option value="">— Select organization —</option>
                            @foreach (var o in orgs)
                            {
                                <option value="@o.Id">@o.OrganizationName</option>
                            }
                        </select>
                        <span asp-validation-for="CreatedByOrganizationId" class="text-danger small"></span>
                    </div>
                }

                <div class="mb-3">
                    <label asp-for="OperationName" class="form-label fw-semibold">Activity Name <span class="text-danger">*</span></label>
                    <input asp-for="OperationName" class="form-control" placeholder="e.g. Flood Relief Operation – Noakhali 2026" />
                    <span asp-validation-for="OperationName" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label fw-semibold">Description</label>
                    <textarea asp-for="Description" class="form-control" rows="4"
                              placeholder="Describe what relief work is being done, who it serves, and the scope."></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-sm-6">
                        <label asp-for="DisasterType" class="form-label fw-semibold">Activity Type</label>
                        <select asp-for="DisasterType" class="form-select">
                            <option value="">— Select type —</option>
                            <option>Food Distribution</option>
                            <option>Drinking Water</option>
                            <option>Medical Aid</option>
                            <option>Rescue Operations</option>
                            <option>Shelter Management</option>
                            <option>Hygiene Kits</option>
                            <option>Baby &amp; Child Support</option>
                            <option>Elderly Support</option>
                            <option>General Flood Relief</option>
                        </select>
                    </div>
                    <div class="col-sm-6">
                        <label asp-for="Status" class="form-label fw-semibold">Status</label>
                        <select asp-for="Status" class="form-select">
                            <option value="Active">Active (visible now)</option>
                            <option value="Pending">Pending (admin review)</option>
                        </select>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Location" class="form-label fw-semibold">Location / District</label>
                    <input asp-for="Location" class="form-control"
                           placeholder="e.g. Sylhet, Sunamganj — all affected areas" />
                    <span asp-validation-for="Location" class="text-danger small"></span>
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-sm-6">
                        <label asp-for="StartDate" class="form-label fw-semibold">Start Date <span class="text-danger">*</span></label>
                        <input asp-for="StartDate" type="date" class="form-control" />
                        <span asp-validation-for="StartDate" class="text-danger small"></span>
                    </div>
                    <div class="col-sm-6">
                        <label asp-for="EndDate" class="form-label fw-semibold">End Date <span class="text-muted">(if known)</span></label>
                        <input asp-for="EndDate" type="date" class="form-control" />
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-fl-green px-4">
                        <i class="bi bi-check-circle me-1"></i>Post Activity
                    </button>
                    <a asp-action="Activities" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>

        </div>
    </div>

</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
