@model FloodLink.Models.Shelter

@{
    ViewData["Title"] = "Delete Shelter";
}

<div class="container mt-4 mb-5">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card shadow-sm border-danger">
                <div class="card-header bg-danger text-white py-3">
                    <h5 class="mb-0">Confirm Delete</h5>
                </div>
                <div class="card-body">
                    <p>Are you sure you want to delete shelter <strong>@Model.ShelterName</strong>?</p>
                    <ul class="text-muted small">
                        <li>Location: @Model.Location</li>
                        <li>Capacity: @Model.Capacity</li>
                        <li>Current Occupancy: @Model.CurrentOccupancy</li>
                    </ul>
                    <div class="alert alert-warning small">This action cannot be undone.</div>
                    <form asp-action="Delete" method="post" class="d-flex gap-2">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <button type="submit" class="btn btn-danger">Yes, Delete</button>
                        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancel</a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
