@model FloodLink.Models.EditUserViewModel

@{
    ViewData["Title"] = $"Edit User - {Model.FullName}";
}

<div class="container py-4 mb-5">

    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
            <li class="breadcrumb-item"><a asp-controller="Account" asp-action="Users">Users & Roles</a></li>
            <li class="breadcrumb-item"><a asp-action="UserDetails" asp-route-id="@Model.Id">@Model.FullName</a></li>
            <li class="breadcrumb-item active" aria-current="page">Edit</li>
        </ol>
    </nav>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-bottom py-3">
                    <h4 class="fw-bold mb-0"><i class="bi bi-pencil-square text-primary me-2"></i> Edit User & Role Privileges</h4>
                    <p class="text-muted small mb-0">Update account details, active status, and assign or remove system roles.</p>
                </div>
                <div class="card-body p-4">

                    <form asp-action="EditUser" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Email Address</label>
                            <input type="text" class="form-control bg-light" value="@Model.Email" readonly disabled />
                            <div class="form-text small">Email cannot be changed directly from role management for security reasons.</div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="FullName" class="form-label fw-semibold">Full Name <span class="text-danger">*</span></label>
                            <input asp-for="FullName" class="form-control" required maxlength="100" />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="PhoneNumber" class="form-label fw-semibold">Phone Number</label>
                            <input asp-for="PhoneNumber" class="form-control" placeholder="e.g. 01712345678" maxlength="20" />
                            <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Status" class="form-label fw-semibold">Account Status</label>
                            <select asp-for="Status" class="form-select">
                                <option value="Active">Active</option>
                                <option value="Inactive">Inactive</option>
                                <option value="Pending">Pending</option>
                            </select>
                            <span asp-validation-for="Status" class="text-danger small"></span>
                        </div>

                        <hr class="my-4" />

                        <div class="mb-4">
                            <label class="form-label fw-bold fs-5 mb-1">
                                <i class="bi bi-shield-lock-fill text-primary me-1"></i> System Roles
                            </label>
                            <p class="text-muted small mb-3">Select the roles this user should hold. Users can hold multiple roles if appropriate.</p>

                            <div class="row g-3">
                                @foreach (var role in Model.AllRoles)
                                {
                                    bool isChecked = Model.SelectedRoles.Contains(role);
                                    <div class="col-md-6">
                                        <div class="form-check p-3 border rounded h-100 @(isChecked ? "bg-light border-primary" : "")">
                                            <input class="form-check-input ms-0 me-2" type="checkbox"
                                                   name="SelectedRoles" value="@role" id="role_@role"
                                                   @(isChecked ? "checked" : "") />
                                            <label class="form-check-label fw-semibold text-dark" for="role_@role">
                                                @role
                                            </label>
                                            <div class="small text-muted ps-4">
                                                @role switch
                                                {
                                                    "Super Admin" => "Full system administrative authority across all modules.",
                                                    "Admin" => "Legacy administrative role with elevated management access.",
                                                    "Organization Admin" or "Organization" => "Manages relief organization teams, shelters, and supplies.",
                                                    "Coordinator" => "Disaster operations coordinator managing field response.",
                                                    "Volunteer" => "Field volunteer accepting and fulfilling help assignments.",
                                                    "Community Reporter" => "Submits ground-level flood reports and hazard updates.",
                                                    "Citizen" => "Standard citizen requesting relief or emergency aid.",
                                                    _ => "General application permissions."
                                                }
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                            <a asp-action="UserDetails" asp-route-id="@Model.Id" class="btn btn-outline-secondary">
                                Cancel
                            </a>
                            <button type="submit" class="btn btn-primary px-4">
                                <i class="bi bi-save me-1"></i> Save Changes
                            </button>
                        </div>
                    </form>

                </div>
            </div>
        </div>
    </div>

</div>
